# ============================================================
#  .htaccess — Martin Svítek portfolio
# ============================================================

RewriteEngine On

# ------------------------------------------------------------
#  1) Hezké adresy bez .html
# ------------------------------------------------------------

# /projects  →  interně načte projects.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# /projects.html  →  natrvalo přesměruje na /projects
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /index.html  →  přesměruje na /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]


# ------------------------------------------------------------
#  2) Vynucení HTTPS
#     (odkomentuj až budeš mít funkční certifikát)
# ------------------------------------------------------------

# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]


# ------------------------------------------------------------
#  3) Vlastní chybová stránka
#     (vytvoř 404.html v kořeni webu)
# ------------------------------------------------------------

ErrorDocument 404 /404.html


# ------------------------------------------------------------
#  4) Kódování — kvůli české diakritice v textu
# ------------------------------------------------------------

AddDefaultCharset UTF-8


# ------------------------------------------------------------
#  5) Zákaz výpisu obsahu složek
#     (bez tohohle by šlo procházet /images/ jako seznam souborů)
# ------------------------------------------------------------

Options -Indexes


# ------------------------------------------------------------
#  6) Cachování obrázků a stylů v prohlížeči
#     Zrychlí opakované návštěvy.
# ------------------------------------------------------------

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg        "access plus 1 month"
  ExpiresByType image/png         "access plus 1 month"
  ExpiresByType image/webp        "access plus 1 month"
  ExpiresByType text/css          "access plus 1 week"
  ExpiresByType application/pdf   "access plus 1 month"
</IfModule>
